# DebtNav API configuration. Copy to .env (git-ignored) and fill in; never commit real values.
# The API reads process.env only: load this file with your process manager, `node --env-file=.env`,
# or your host's secret settings. See docs/BACKEND.md.

# development | production. Production forces Secure cookies and ignores the two OIDC_ALLOW_* flags.
NODE_ENV=development

# Port the API listens on (PORT is also accepted). Vite dev/preview proxy /api here.
API_PORT=8787

# Public origin of the app, no trailing slash. The OAuth redirect URI is ${APP_ORIGIN}/api/auth/callback.
# Local dev with `npm run dev`: http://localhost:5173. Production: https://your-domain.
APP_ORIGIN=http://localhost:5173

# Database. Set DATABASE_URL for PostgreSQL (production). Without it, an embedded PGlite database is
# stored in PGLITE_DIR (default .data/pglite); PGLITE_DIR=memory:// keeps it in memory (lost on restart).
# DATABASE_URL=postgres://debtnav:CHANGE_ME@localhost:5432/debtnav?sslmode=require
PGLITE_DIR=.data/pglite

# Google sign-in (OpenID Connect). Without a client ID and secret the app shows a setup screen
# instead of signing anyone in. Create a "Web application" OAuth client in Google Cloud Console.
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Local mock issuers only (plain HTTP issuer, login_hint passthrough). Ignored when NODE_ENV=production.
# OIDC_ALLOW_INSECURE=0
# OIDC_ALLOW_LOGIN_HINT=0

# Session lifetime in days (1–365).
SESSION_TTL_DAYS=30

# Requests per minute per client IP (first X-Forwarded-For hop).
RATE_LIMIT_PER_MINUTE=300

# Directory of the built SPA to serve from the API. Defaults to dist in production; unset in dev.
# SERVE_STATIC_DIR=dist
