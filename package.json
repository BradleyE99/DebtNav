{
  "name": "debtnav",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p server && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint:money": "node scripts/check-money.mjs",
    "test:bench": "vitest bench --run src/engine/planner.bench.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "lint": "eslint . && node scripts/check-money.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:bench && npm run build",
    "dev:api": "tsx watch server/src/index.ts",
    "start": "tsx server/src/index.ts",
    "db:migrate": "tsx server/src/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@hono/node-server": "^2.1.5",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "hono": "^4.13.13",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^5.0.4",
    "axe-core": "^4.10.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^26.0.0",
    "oauth2-mock-server": "^9.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
